<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_staffpass_integration" model="res.groups">
        <field name="name">StaffPass Integration User</field>
        <field name="comment">May import StaffPass payroll journals for explicitly enabled companies.</field>
        <field name="category_id" ref="base.module_category_accounting"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_user'))]"/>
    </record>

    <record id="rule_staffpass_import_company" model="ir.rule">
        <field name="name">StaffPass imports: allowed companies only</field>
        <field name="model_id" ref="model_staffpass_payroll_import"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
