<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_staffpass_payroll_import_list" model="ir.ui.view">
        <field name="name">staffpass.payroll.import.list</field>
        <field name="model">staffpass.payroll.import</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="create_date"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="external_id"/>
                <field name="journal_type"/>
                <field name="move_id"/>
                <field name="move_state"/>
                <field name="line_count"/>
                <field name="total_debit" sum="Total debit"/>
                <field name="total_credit" sum="Total credit"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_staffpass_payroll_import_form" model="ir.ui.view">
        <field name="name">staffpass.payroll.import.form</field>
        <field name="model">staffpass.payroll.import</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="external_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="journal_type"/>
                            <field name="move_id"/>
                            <field name="move_state"/>
                        </group>
                        <group>
                            <field name="source_hash"/>
                            <field name="line_count"/>
                            <field name="total_debit"/>
                            <field name="total_credit"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_staffpass_payroll_imports" model="ir.actions.act_window">
        <field name="name">Payroll imports</field>
        <field name="res_model">staffpass.payroll.import</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
